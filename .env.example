# Telegram
BOT_TOKEN=
BOT_USERNAME=
TELEGRAM_PROXY=socks5://172.21.0.2:10808

# Application
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Database — SINGLE PostgreSQL database shared by Bot + Mini App + API
# Do not create a separate Mini App database.
DATABASE_URL=
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10

# GitHub updater
GITHUB_REPOSITORY=WhiteBelStudio/WhiteBelStudio-Bot
GITHUB_BRANCH=main
GITHUB_UPDATE_ENABLED=true
GITHUB_TOKEN=

# Admin
OWNER_ID=

# API
API_HOST=0.0.0.0
API_PORT=8080
API_DOCS_ENABLED=true
# Comma-separated exact frontend origins, e.g. https://example.vercel.app
API_CORS_ORIGINS=

# Security
SECRET_KEY=
